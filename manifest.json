{
  "name": "OpenAthens",
  "description": "This extension will display your OpenAthens login status and into which service you are signed in.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html",
    "default_icon": "icons/icon32.png"
  },
   "icons": {
          "16": "icons/icon16.png",
          "32": "icons/icon32.png",
          "48": "icons/icon48.png",
          "128": "icons/icon128.png"
        },
  "permissions": [
  "cookies",
  "bookmarks",
  "sidePanel",
  "background","webRequest","webNavigation","tabs","notifications", "scripting"

],
 "background": {
    "service_worker": "service-worker.js", "type": "module"
  },
"host_permissions": [
    "https://my.openathens.net/*",
  "*://*/*"
],
"side_panel": {
  "default_path": "sidepanel.html"
}
}